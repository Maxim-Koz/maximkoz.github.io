---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FourierWord from "../../components/FourierWord.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const GITHUB = "https://github.com/Maxim-Koz";

const newestFirst = (
	a: { data: { pubDate: Date } },
	b: { data: { pubDate: Date } },
) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

const allProjects = (await getCollection("projects")).sort(newestFirst);

const pinned = allProjects.filter((project) => project.data.pinned);
const hasProjects = allProjects.length > 0;
---

<BaseLayout
	title="Projects"
	description="A collection of my projects."
	background={false}
>
	<div style="width: min(100vw - 2rem, 600px); margin-left: 50%; transform: translateX(-50%);">
		<FourierWord text="Projects" font="grotesk" fade={true} />
	</div>
	<p class="intro">
		Things I’ve built, from animations and apps to experiments. Open any
		project to see how it works.
	</p>

	{!hasProjects && (
		<section class="empty">
			<h2>Projects are on their way</h2>
			<p>
				I’m writing up what I’ve built. In the meantime, the code is on
				<a href={GITHUB} target="_blank" rel="noopener noreferrer">
					GitHub
				</a>
				.
			</p>
		</section>
	)}

	{pinned.length > 0 && (
		<section aria-labelledby="pinned-heading">
			<p class="section-label" id="pinned-heading">
				Featured
			</p>
			<ul class="pinned-grid">
				{pinned.map((project) => (
					<li>
						<a
							href={`/projects/${project.id}/`}
							class="pinned-card"
						>
							<div class="thumb">
								{project.data.heroImage && (
									<Image
										width={720}
										height={360}
										src={project.data.heroImage}
										alt=""
									/>
								)}
							</div>
							<div class="body">
								<div class="meta">
									<FormattedDate
										date={project.data.pubDate}
									/>
								</div>
								<h2 class="title">{project.data.title}</h2>
								<p class="description">
									{project.data.description}
								</p>
								<span class="cta">View project →</span>
							</div>
						</a>
					</li>
				))}
			</ul>
			<p class="section-label timeline-label">All projects</p>
		</section>
	)}

	{hasProjects && (
		<ol class="timeline">
			{allProjects.map((project) => (
				<li class="project" data-project>
					<span class="dot" aria-hidden="true" />
					<a
						href={`/projects/${project.id}/`}
						class:list={[
							"card",
							{ "has-thumb": Boolean(project.data.heroImage) },
						]}
					>
						<div class="body">
							<div class="meta">
								<FormattedDate date={project.data.pubDate} />
							</div>
							<h2 class="title">{project.data.title}</h2>
							<p class="description">
								{project.data.description}
							</p>
							<span class="cta">View project →</span>
						</div>
						{project.data.heroImage && (
							<div class="thumb">
								<Image
									width={720}
									height={360}
									src={project.data.heroImage}
									alt=""
								/>
							</div>
						)}
					</a>
				</li>
			))}
		</ol>
	)}
</BaseLayout>

<style is:global>
	html {
		scroll-snap-type: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		html.snap-ready {
			scroll-snap-type: y proximity;
		}
	}
</style>

<style>
	main {
		width: 840px;
	}

	/* ---------- Intro and empty state ---------- */
	.intro {
		max-width: 34rem;
		margin: 0.5rem auto 0;
		text-align: center;
		font-size: 1.05em;
		line-height: 1.6;
		color: var(--text-muted);
	}
	.empty {
		margin-top: 3rem;
		padding: 2.5rem 2rem;
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--surface);
		text-align: center;
	}
	.empty h2 {
		margin: 0 0 0.5rem;
		font-size: 1.4em;
	}
	.empty p {
		margin: 0;
		color: var(--text-muted);
	}

	/* ---------- Shared card pieces ---------- */
	.meta {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		font-size: 0.7em;
		color: var(--grey);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.title {
		margin: 0.3rem 0 0.5rem;
		font-size: 1.5em;
		line-height: 1.25;
		color: var(--heading);
		transition: color 0.2s ease;
	}
	.description {
		margin: 0;
		font-size: 0.88em;
		line-height: 1.6;
		color: var(--text-muted);
	}
	.cta {
		display: inline-block;
		margin-top: 1rem;
		font-size: 0.85em;
		font-weight: 600;
		color: var(--accent);
	}
	.thumb {
		aspect-ratio: 2 / 1;
		overflow: hidden;
		background: linear-gradient(135deg, var(--accent-soft), var(--surface));
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		margin: 0;
		border-radius: 0;
	}

	.pinned-card:hover .title,
	.card:hover .title {
		color: var(--accent);
	}
	.pinned-card:hover .cta,
	.card:hover .cta {
		text-decoration: underline;
	}
	.pinned-card:focus-visible,
	.card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	/* ---------- Featured ---------- */
	.section-label {
		margin: 2.5rem 0 0.75rem;
		font-size: 0.7em;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent);
		font-weight: 700;
	}
	.timeline-label {
		margin-top: 3.5rem;
		color: var(--grey);
	}
	.pinned-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}
	.pinned-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		box-sizing: border-box;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 20px;
		text-decoration: none;
		color: var(--text);
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.pinned-card:hover {
		border-color: var(--accent);
		box-shadow: var(--shadow);
	}
	.pinned-card .thumb {
		border-bottom: 1px solid var(--border);
	}
	.pinned-card .body {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.1rem 1.4rem 1.4rem;
	}
	.pinned-card .cta {
		margin-top: auto;
		padding-top: 1rem;
	}

	/* ---------- Timeline ---------- */
	.timeline {
		--line-x: 0.75rem;
		list-style: none;
		margin: 2rem 0 0;
		padding: 0 0 0 3rem;
		position: relative;
	}
	.timeline::before {
		content: "";
		position: absolute;
		left: var(--line-x);
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--border);
	}

	.project {
		--focus: 0;
		position: relative;
		min-height: 50vh;
		display: flex;
		align-items: center;
		scroll-snap-align: center;
	}

	.dot {
		position: absolute;
		left: calc(var(--line-x) - 3rem - 6px);
		top: 50%;
		width: 14px;
		height: 14px;
		margin-top: -7px;
		border-radius: 50%;
		background: color-mix(
			in srgb,
			var(--accent) calc(var(--focus) * 100%),
			var(--border)
		);
		box-shadow: 0 0 0 4px var(--bg);
		transform: scale(calc(1 + 0.5 * var(--focus)));
	}

	.card {
		display: grid;
		gap: 1.5rem;
		align-items: center;
		width: 100%;
		box-sizing: border-box;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid
			color-mix(
				in srgb,
				var(--accent) calc(var(--focus) * 100%),
				var(--border)
			);
		border-radius: 20px;
		text-decoration: none;
		color: var(--text);
		transform-origin: left center;
		transform: scale(calc(0.88 + 0.12 * var(--focus)));
		opacity: calc(0.35 + 0.65 * var(--focus));
		will-change: transform, opacity;
	}
	.card.has-thumb {
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
	}
	.card:hover {
		box-shadow: var(--shadow);
	}
	.card .thumb {
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	.card .thumb img {
		filter: grayscale(calc(1 - var(--focus)));
	}

	@media (max-width: 720px) {
		.intro {
			font-size: 1em;
		}
		.pinned-grid {
			grid-template-columns: 1fr;
		}
		.pinned-card .body {
			padding: 1rem 1.1rem 1.2rem;
		}
		.timeline {
			padding-left: 2.25rem;
		}
		.dot {
			left: calc(var(--line-x) - 2.25rem - 6px);
		}
		.card {
			padding: 1.1rem;
			gap: 1rem;
		}
		.card.has-thumb {
			grid-template-columns: 1fr;
		}
		.card.has-thumb .thumb {
			order: -1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.dot {
			transform: none;
		}
	}
</style>

<script>
	const items = Array.from(
		document.querySelectorAll<HTMLElement>("[data-project]"),
	);
	let queued = false;

	function update() {
		queued = false;
		const mid = window.innerHeight / 2;
		items.forEach((el, i) => {
			const r = el.getBoundingClientRect();
			let distance = Math.abs(r.top + r.height / 2 - mid);
			// first and last stay highlighted at either end of the page
			if (i === 0 && r.top + r.height / 2 > mid) distance = 0;
			if (i === items.length - 1 && r.top + r.height / 2 < mid)
				distance = 0;
			const focus = Math.max(0, 1 - distance / r.height);
			el.style.setProperty("--focus", focus.toFixed(3));
		});
	}

	function queueUpdate() {
		if (!queued) {
			queued = true;
			requestAnimationFrame(update);
		}
	}

	window.addEventListener("scroll", queueUpdate, { passive: true });
	window.addEventListener("resize", queueUpdate);
	update();

	const root = document.documentElement;
	const first = items[0];

	// Snapping only switches on once the visitor actually scrolls
	const enableSnap = () =>
		document.documentElement.classList.add("snap-ready");
	["wheel", "touchstart", "keydown", "pointerdown"].forEach((type) =>
		window.addEventListener(type, enableSnap, {
			once: true,
			passive: true,
		}),
	);

	function syncSnap() {
		if (!first) return;
		const r = first.getBoundingClientRect();
		const centre = r.top + r.height / 2;
		root.style.scrollSnapType =
			centre >= window.innerHeight / 2 - r.height / 2 ? "none" : "";
	}

	window.addEventListener("scroll", syncSnap, { passive: true });
	window.addEventListener("resize", syncSnap);
	syncSnap();

	// arrow keys jump between projects
	let pending: number | null = null;
	let pendingTimer: number | undefined;

	function centreOf(el: HTMLElement) {
		const r = el.getBoundingClientRect();
		return r.top + r.height / 2;
	}

	function goTo(direction: 1 | -1): boolean {
		const mid = window.innerHeight / 2;
		const tolerance = 10;
		let target = -1;

		if (pending !== null) {
			target = pending + direction;
		} else if (direction === 1) {
			target = items.findIndex((el) => centreOf(el) > mid + tolerance);
		} else {
			items.forEach((el, i) => {
				if (centreOf(el) < mid - tolerance) target = i;
			});
		}

		if (target < 0 || target >= items.length) return false;

		pending = target;
		window.clearTimeout(pendingTimer);
		pendingTimer = window.setTimeout(() => (pending = null), 700);

		const reduceMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		items[target].scrollIntoView({
			behavior: reduceMotion ? "auto" : "smooth",
			block: "center",
		});
		return true;
	}

	window.addEventListener("keydown", (e) => {
		if (
			e.defaultPrevented ||
			e.altKey ||
			e.ctrlKey ||
			e.metaKey ||
			e.shiftKey
		)
			return;
		if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
		const el = e.target as HTMLElement;
		if (el.closest("input, textarea, select, [contenteditable]")) return;

		if (goTo(e.key === "ArrowDown" ? 1 : -1)) e.preventDefault();
	});
</script>
