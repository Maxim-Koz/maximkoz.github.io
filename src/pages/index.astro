---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import FourierWord from "../components/FourierWord.astro";
import FourierSketch from "../components/FourierSketch.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const EMAIL = "maxim.kozlovskiy.contact@gmail.com";
const LINKEDIN = "https://www.linkedin.com/in/maxim-kozlovskiy";
const GITHUB = "https://github.com/Maxim-Koz";
const HOW_IT_WORKS = "/projects";

const portraits = import.meta.glob<ImageMetadata>(
	"../assets/portrait.{jpg,jpeg,png,webp}",
	{ eager: true, import: "default" },
);
const portrait = Object.values(portraits)[0];

// Feather-style icons (24x24, stroke only)
const areas = [
	{
		title: "Mathematics",
		text: "Studying Mathematics at the University of Warwick. My interests are machine learning, maths and physics.",
		icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
	},
	{
		title: "Tutoring",
		text: "One-to-one GCSE and A-level Maths and Further Maths tutoring, with a focus on understanding why a method works, not just how.",
		icon: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
		href: "/tutoring",
		cta: "Tutoring",
	},
	{
		title: "Building",
		text: "Projects in TypeScript and Dart, from the Fourier animations on this site to a gym rep-tracking app.",
		icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
		href: "/projects",
		cta: "Projects",
	},
];
---

<BaseLayout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	background={false}
>
	<!-- ============ Hero ============ -->
	<section class="hero">
		<div class="hero-text">
			<p class="eyebrow">Mathematics · University of Warwick</p>
			<h1>
				Maxim Kozlovskiy<span class="dot">.</span>
			</h1>
			<p class="lead">
				I study Mathematics at the University of Warwick. I tutor GCSE
				and A-level Maths and Further Maths, and I build things with
				code, from animations of Fourier series to small apps.
			</p>
			<div class="actions">
				<a class="btn btn-primary" href="#contact">
					Get in touch
				</a>
				<a class="btn btn-secondary" href="/projects">
					See my projects
				</a>
			</div>
		</div>

		<div class="portrait">
			<div class="portrait-frame">
				{portrait ? (
					<Image
						src={portrait}
						alt="Maxim Kozlovskiy"
						width={760}
						height={950}
						loading="eager"
					/>
				) : (
					<div class="placeholder" aria-hidden="true">
						<span>
							MK<span class="dot">.</span>
						</span>
					</div>
				)}
			</div>
		</div>
	</section>

	<!-- ============ What I do ============ -->
	<section class="section">
		<h2>What I do</h2>
		<div class="areas">
			{areas.map((area) => (
				<article class="area">
					<div class="icon">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<Fragment set:html={area.icon} />
						</svg>
					</div>
					<h3>{area.title}</h3>
					<p>{area.text}</p>
					{area.href && (
						<a class="more" href={area.href}>
							{area.cta} →
						</a>
					)}
				</article>
			))}
		</div>
	</section>

	<!-- ============ The circles ============ -->
	<section class="section feature">
		<div class="feature-art">
			<FourierWord
				text="Maxim"
				font="grotesk"
				density={1.5}
				circles={450}
				fade={true}
			/>
		</div>
		<div class="feature-text">
			<p class="eyebrow">Behind the drawings</p>
			<h2>Find out how these drawings are made</h2>
			<p>
				The animated drawings on this site are Fourier series: chains of
				rotating circles whose tips trace out shapes. They run live in
				your browser, written from scratch in TypeScript.
			</p>
			<a class="more" href={HOW_IT_WORKS}>
				See how they work →
			</a>
		</div>
	</section>

	<!-- ============ Try it ============ -->
	<section class="section sketch-section">
		<div class="sketch-text">
			<p class="eyebrow">Try it yourself</p>
			<h2>Draw a shape, watch the circles</h2>
			<p>
				Draw anything in the box in a single line, with a mouse or a
				finger. It's turned into a Fourier series and redrawn by a chain
				of circles, live in your browser.
			</p>
		</div>
		<FourierSketch circles={120} />
	</section>

	<!-- ============ Contact ============ -->
	<section class="section contact" id="contact">
		<h2>Get in touch</h2>
		<p>For tutoring enquiries, projects, or just to say hello.</p>
		<div class="actions">
			<a class="btn btn-primary" href={`mailto:${EMAIL}`}>
				{EMAIL}
			</a>
			<a
				class="btn btn-secondary"
				href={LINKEDIN}
				target="_blank"
				rel="noopener noreferrer"
			>
				LinkedIn
			</a>
			<a
				class="btn btn-secondary"
				href={GITHUB}
				target="_blank"
				rel="noopener noreferrer"
			>
				GitHub
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.dot {
		color: var(--fourier);
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		font-size: 0.8em;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: 3rem;
		align-items: center;
		padding: 1rem 0 2rem;
	}
	.hero h1 {
		margin: 0 0 1rem;
		font-size: clamp(2.3rem, 5.5vw, 3.5rem);
	}
	.lead {
		max-width: 34rem;
		margin: 0;
		font-size: 1.1em;
		color: var(--text-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.btn {
		display: inline-block;
		padding: 0.7rem 1.3rem;
		border: 1px solid var(--accent);
		border-radius: 999px;
		font-size: 0.85em;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		transition:
			background 0.15s ease,
			border-color 0.15s ease;
	}
	.btn-primary {
		background: var(--accent);
		color: var(--bg);
	}
	.btn-primary:hover {
		background: var(--accent-hover);
		border-color: var(--accent-hover);
		color: var(--bg);
	}
	.btn-secondary {
		background: transparent;
		color: var(--accent);
	}
	.btn-secondary:hover {
		background: var(--accent-soft);
	}

	/* ---------- Portrait ---------- */
	.portrait {
		position: relative;
		justify-self: end;
		width: min(100%, 360px);
	}
	/* an offset outline in the drawing colour, peeking out behind the photo */
	.portrait::before {
		content: "";
		position: absolute;
		inset: 14px 14px -14px -14px;
		border: 2px solid var(--fourier);
		border-radius: 28px;
		opacity: 0.6;
		z-index: 0;
	}
	.portrait-frame {
		position: relative;
		z-index: 1;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 28px;
		background: var(--surface);
		box-shadow: var(--shadow);
	}
	.portrait-frame :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		border-radius: 0;
		object-fit: cover;
	}
	.placeholder {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--accent-soft), var(--surface));
		font-family: var(--font-space-grotesk);
		font-size: 4.5rem;
		font-weight: 700;
		color: var(--heading);
	}

	/* ---------- Sections ---------- */
	.section {
		margin-top: 4.5rem;
	}
	.section h2 {
		margin: 0 0 1.25rem;
		font-size: clamp(1.7rem, 4vw, 2.3rem);
	}

	.areas {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 1.25rem;
	}
	.area {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--surface);
	}
	.icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		margin-bottom: 1rem;
		border-radius: 12px;
		background: var(--accent-soft);
		color: var(--accent);
	}
	.icon svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.area h3 {
		margin: 0 0 0.4rem;
		font-size: 1.25em;
	}
	.area p {
		margin: 0 0 1rem;
		font-size: 0.85em;
		line-height: 1.6;
		color: var(--text-muted);
	}
	.more {
		margin-top: auto;
		font-size: 0.85em;
		font-weight: 600;
		text-decoration: none;
	}
	.more:hover {
		text-decoration: underline;
	}

	/* ---------- Feature: the circles ---------- */
	.feature {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 3rem;
		align-items: center;
		padding: 2.5rem;
		border: 1px solid var(--border);
		border-radius: 28px;
		background: var(--surface);
	}
	.feature-text p:not(.eyebrow) {
		font-size: 0.9em;
		line-height: 1.7;
		color: var(--text-muted);
	}
	.feature-text h2 {
		margin-bottom: 1rem;
	}

	/* ---------- Try it ---------- */
	.sketch-section {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: 3rem;
		align-items: center;
	}
	.sketch-text p:not(.eyebrow) {
		font-size: 0.9em;
		line-height: 1.7;
		color: var(--text-muted);
	}
	.sketch-text h2 {
		margin-bottom: 1rem;
	}

	/* ---------- Contact ---------- */
	.contact {
		padding: 3rem 2rem;
		border-top: 1px solid var(--border);
		text-align: center;
	}
	.contact p {
		margin: 0;
		color: var(--text-muted);
	}
	.contact .actions {
		justify-content: center;
	}

	/* ---------- Small screens ---------- */
	@media (max-width: 800px) {
		.hero,
		.feature,
		.sketch-section {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.portrait {
			order: -1;
			justify-self: center;
			width: min(70%, 260px);
		}
		.feature {
			padding: 1.5rem;
		}
	}
</style>
