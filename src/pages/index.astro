---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import FourierCanvas from "../components/FourierCanvas.astro";
import FourierWord from "../components/FourierWord.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

// ---------- Edit these ----------
const EMAIL = "maxim.kozlovskiy.contact@gmail.com";
const LINKEDIN = "https://www.linkedin.com/in/maxim-kozlovskiy";
const GITHUB = "https://github.com/Maxim-Koz";

// Portrait: save a photo as src/assets/portrait.jpg (or .jpeg / .png / .webp)
// and it appears here automatically. Until then a placeholder is shown.
const portraits = import.meta.glob<ImageMetadata>(
	"../assets/portrait.{jpg,jpeg,png,webp}",
	{ eager: true, import: "default" },
);
const portrait = Object.values(portraits)[0];

// Feather-style icons (24x24, stroke only)
const areas = [
	{
		title: "Mathematics",
		text: "Studying Mathematics at the University of Warwick. Interested in mathematical problem-solving, algorithms, machine learning and quantitative modelling.",
		icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
	},
	{
		title: "Tutoring",
		text: "One-to-one GCSE and A-level Maths and Further Maths tutoring, with a focus on understanding why a method works, not just how.",
		icon: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
		href: "/tutoring",
		cta: "Tutoring",
	},
	{
		title: "Building",
		text: "A selection of things I've built, exploring ideas through code and experimentation.",
		icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
		href: "/projects",
		cta: "Projects",
	},
];
---

<BaseLayout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	background={false}
>
	<!-- ============ Hero ============ -->
	<section class="hero">
		<div class="hero-text">
			<p class="eyebrow">Mathematics · University of Warwick</p>
			<h1>
				Maxim Kozlovskiy<span class="dot">.</span>
			</h1>
			<p class="lead">
				I’m a Mathematics student at the University of Warwick. I tutor
				GCSE and A-level Maths and Further Maths, and I enjoy using code
				to bring ideas to life, from Fourier series visualisations to
				small apps and other projects.
			</p>
			<div class="actions">
				<a class="btn btn-primary" href="#contact">
					Get in touch
				</a>
				<a class="btn btn-secondary" href="/projects">
					See my projects
				</a>
			</div>
		</div>

		<div class="portrait">
			<div class="portrait-frame">
				{portrait ? (
					<Image
						src={portrait}
						alt="Maxim Kozlovskiy"
						width={760}
						height={950}
						loading="eager"
					/>
				) : (
					<div class="placeholder" aria-hidden="true">
						<span>
							MK<span class="dot">.</span>
						</span>
					</div>
				)}
			</div>
		</div>
	</section>

	<!-- ============ What I do ============ -->
	<section class="section">
		<h2>What I do</h2>
		<div class="areas">
			{areas.map((area) => (
				<article class="area">
					<div class="icon">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<Fragment set:html={area.icon} />
						</svg>
					</div>
					<h3>{area.title}</h3>
					<p>{area.text}</p>
					{area.href && (
						<a class="more" href={area.href}>
							{area.cta} →
						</a>
					)}
				</article>
			))}
		</div>
	</section>

	<!-- ============ The circles ============ -->
	<section class="section feature">
		<div class="feature-art">
			<FourierWord
				text="Maxim"
				font="grotesk"
				density={1.5}
				circles={100}
				secondsPerContour={15}
				fade={true}
				fadeSeconds={15}
			/>
		</div>
		<div class="feature-text">
			<p class="eyebrow">Behind the drawings</p>
			<h2>Find out how these drawings are made</h2>
			<p>
				The animations on this site are written from scratch in
				TypeScript and run live in your browser, not as recordings. The
				projects page walks through how each one works.
			</p>
			<a class="more" href="/projects">
				See the projects →
			</a>
		</div>
	</section>

	<!-- ============ Fourier showcase ============ -->
	<section class="section showcase">
		<div class="showcase-text">
			<p class="eyebrow">Fourier series</p>
			<h2>Any shape can be drawn with circles</h2>
			<p>
				A Fourier series breaks a closed curve into a chain of circles,
				each turning at its own steady speed. The tip of the last arm
				traces out the shape, and the more circles you add, the closer
				the drawing gets to the original.
			</p>
			<p>The π on the right is drawn this way, using 200 circles.</p>
		</div>
		<div class="showcase-art" aria-hidden="true">
			<FourierCanvas shape="pi" circles={200} />
		</div>
	</section>

	<!-- ============ Contact ============ -->
	<section class="section contact" id="contact">
		<h2>Get in touch</h2>
		<p>For tutoring enquiries, projects, or just to say hello.</p>
		<div class="actions">
			<a class="btn btn-primary" href={`mailto:${EMAIL}`}>
				{EMAIL}
			</a>
			<a
				class="btn btn-secondary"
				href={LINKEDIN}
				target="_blank"
				rel="noopener noreferrer"
			>
				LinkedIn
			</a>
			<a
				class="btn btn-secondary"
				href={GITHUB}
				target="_blank"
				rel="noopener noreferrer"
			>
				GitHub
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.dot {
		color: var(--fourier);
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		font-size: 0.8em;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: 3rem;
		align-items: center;
		padding: 1rem 0 2rem;
	}
	.hero h1 {
		margin: 0 0 1rem;
		font-size: clamp(2.3rem, 5.5vw, 3.5rem);
	}
	.lead {
		max-width: 34rem;
		margin: 0;
		font-size: 1.1em;
		color: var(--text-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.btn {
		display: inline-block;
		padding: 0.7rem 1.3rem;
		border: 1px solid var(--accent);
		border-radius: 999px;
		font-size: 0.85em;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		transition:
			background 0.15s ease,
			border-color 0.15s ease;
	}
	.btn-primary {
		background: var(--accent);
		color: var(--bg);
	}
	.btn-primary:hover {
		background: var(--accent-hover);
		border-color: var(--accent-hover);
		color: var(--bg);
	}
	.btn-secondary {
		background: transparent;
		color: var(--accent);
	}
	.btn-secondary:hover {
		background: var(--accent-soft);
	}

	/* ---------- Portrait ---------- */
	.portrait {
		position: relative;
		justify-self: end;
		width: min(100%, 360px);
	}
	.portrait-frame {
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 28px;
		background: var(--surface);
		box-shadow: var(--shadow);
	}
	.portrait-frame :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		border-radius: 0;
		object-fit: cover;
	}
	.placeholder {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--accent-soft), var(--surface));
		font-family: var(--font-space-grotesk);
		font-size: 4.5rem;
		font-weight: 700;
		color: var(--heading);
	}

	/* ---------- Sections ---------- */
	.section {
		margin-top: 4.5rem;
	}
	.section h2 {
		margin: 0 0 1.25rem;
		font-size: clamp(1.7rem, 4vw, 2.3rem);
	}

	.areas {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 1.25rem;
	}
	.area {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--surface);
	}
	.icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		margin-bottom: 1rem;
		border-radius: 12px;
		background: var(--accent-soft);
		color: var(--accent);
	}
	.icon svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.area h3 {
		margin: 0 0 0.4rem;
		font-size: 1.25em;
	}
	.area p {
		margin: 0 0 1rem;
		font-size: 0.85em;
		line-height: 1.6;
		color: var(--text-muted);
	}
	.more {
		margin-top: auto;
		font-size: 0.85em;
		font-weight: 600;
		text-decoration: none;
	}
	.more:hover {
		text-decoration: underline;
	}

	/* ---------- Feature: the circles ---------- */
	.feature {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 3rem;
		align-items: center;
		padding: 2.5rem;
		border: 1px solid var(--border);
		border-radius: 28px;
		background: var(--surface);
	}
	.feature-text p:not(.eyebrow) {
		font-size: 0.9em;
		line-height: 1.7;
		color: var(--text-muted);
	}
	.feature-text h2 {
		margin-bottom: 1rem;
	}

	/* ---------- Showcase: the π ---------- */
	.showcase {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: 3rem;
		align-items: center;
	}
	.showcase-text h2 {
		margin-bottom: 1rem;
	}
	.showcase-text p:not(.eyebrow) {
		max-width: 32rem;
		font-size: 0.9em;
		line-height: 1.7;
		color: var(--text-muted);
	}
	.showcase-art {
		width: 100%;
		max-width: 520px;
		justify-self: center;
	}

	/* ---------- Contact ---------- */
	.contact {
		padding: 3rem 2rem;
		border-top: 1px solid var(--border);
		text-align: center;
	}
	.contact p {
		margin: 0;
		color: var(--text-muted);
	}
	.contact .actions {
		justify-content: center;
	}

	/* ---------- Small screens ---------- */
	@media (max-width: 800px) {
		.hero,
		.feature,
		.showcase {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.portrait {
			order: -1;
			justify-self: center;
			width: min(70%, 260px);
		}
		.showcase-art {
			max-width: 380px;
		}
		.feature {
			padding: 1.5rem;
		}
	}
</style>
